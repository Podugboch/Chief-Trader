# ==============================================================================
# CRYPTO TRADING BOT ENVIRONMENT CONFIGURATION
# ==============================================================================
# IMPORTANT: Never commit your real .env file or share API keys with anyone!
# Ensure API keys only have 'SPOT TRADING' permissions enabled (NO WITHDRAWALS).

# Trading Mode: 'paper' (simulated, zero risk) or 'testnet' or 'live'
TRADING_MODE=paper

# Exchange Selection: 'binance', 'mexc', 'bybit', 'okx', 'kraken', 'coinbase', 'kucoin', 'bitget', 'gateio', 'htx'
EXCHANGE_NAME=mexc

# Exchange API Credentials (Leave blank if running purely in 'paper' mode)
API_KEY=
API_SECRET=
API_PASSPHRASE=
USE_TESTNET=true

# Binance Specific (Backward compatible)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_USE_TESTNET=true

# Trading Pair & Timeframe Configuration
DEFAULT_SYMBOL=BTCUSDT
TRADING_PAIRS=BTCUSDT,ETHUSDT,SOLUSDT,BNBUSDT,XRPUSDT,ADAUSDT,DOGEUSDT,AVAXUSDT
DEFAULT_TIMEFRAME=1h

# Risk Management Guardrails
MAX_RISK_PER_TRADE_PCT=0.015       # 1.5% risk of total equity per trade
MAX_ACCOUNT_LEVERAGE=1.0           # Spot bot: 1.0 (no leverage)
MAX_OPEN_POSITIONS=3               # Max concurrent positions
MAX_DAILY_DRAWDOWN_PCT=0.05        # 5% daily circuit breaker limit
MAX_TOTAL_DRAWDOWN_PCT=0.15        # 15% overall strategy circuit breaker limit
ATR_STOP_MULTIPLIER=2.0            # ATR trailing stop distance
ATR_TAKE_PROFIT_MULTIPLIER=3.5     # ATR take profit target (RR ~ 1.75:1)
FEE_RATE=0.001                     # 0.10% standard exchange fee
SLIPPAGE_BPS=5                     # 5 basis points (0.05%) estimated slippage

# Circuit Breakers & Cool-off
VOLATILITY_CIRCUIT_BREAKER_ATR_MULT=3.0  # Pause trading if ATR spikes 3x avg
CIRCUIT_BREAKER_COOLDOWN_BARS=4          # Number of bars to stay paused
